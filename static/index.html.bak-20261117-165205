<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CasparCG Monitor by sendust</title>
<style>
  :root {
    --bg: #0f1216; --panel: #171b21; --panel2: #1e232b; --line: #2a313b;
    --text: #e3e8ef; --dim: #8b96a5; --accent: #4ea1ff;
    --ok: #3ccf7a; --warn: #f2b33d; --bad: #ff5d5d; --mono: ui-monospace, "JetBrains Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.45 system-ui, "Noto Sans KR", sans-serif; }
  header { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px;
           padding: 10px 16px; background: #0b0e12ee; border-bottom: 1px solid var(--line); backdrop-filter: blur(4px); }
  header h1 { font-size: 17px; margin: 0; font-weight: 650; letter-spacing: .2px; }
  header h1 .by { font-size: 12.5px; font-weight: 400; color: var(--dim); margin-left: 4px; }
  header .host { color: var(--dim); font-family: var(--mono); font-size: 13px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
          background: var(--panel2); border: 1px solid var(--line); font-size: 12.5px; white-space: nowrap; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--dim); }
  .dot.ok { background: var(--ok); box-shadow: 0 0 6px var(--ok); }
  .dot.bad { background: var(--bad); box-shadow: 0 0 6px var(--bad); }
  .dot.warn { background: var(--warn); }
  .spacer { flex: 1; }
  .clock { font-family: var(--mono); color: var(--dim); font-size: 13px; }
  .actions { display: flex; gap: 8px; }
  .actions button { border-radius: 6px; padding: 6px 14px; font-weight: 600; cursor: pointer; border: 1px solid; }
  .actions button:disabled { opacity: .4; cursor: not-allowed; }
  button.kill { background: #3a1416; color: #ffb3b3; border-color: #7a2a2e; }
  button.kill:hover:not(:disabled) { background: #5a1a1e; color: #fff; }
  button.stop { background: #3a2a10; color: #ffd28a; border-color: #7a5a22; }
  button.stop:hover:not(:disabled) { background: #5a4012; color: #fff; }
  button.start { background: #10301c; color: #9ff0bf; border-color: #23683d; }
  button.start:hover:not(:disabled) { background: #164a2a; color: #fff; }

  main { display: grid; gap: 12px; padding: 12px 16px 24px; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); }
  section { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; min-width: 0; }
  section.wide { grid-column: 1 / -1; }
  /* double-width card; only when two grid columns fit (2 x 360px + gap + page padding) */
  @media (min-width: 800px) { section.span2 { grid-column: span 2; } }
  section h2 { margin: 0 0 10px; font-size: 13px; text-transform: uppercase; letter-spacing: .8px; color: var(--dim);
               display: flex; align-items: center; gap: 10px; }
  section h2 .right { margin-left: auto; text-transform: none; letter-spacing: 0; font-weight: 400; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; min-width: 0; }
  section h2 { flex-wrap: wrap; }
  .kv { display: grid; grid-template-columns: max-content 1fr; gap: 3px 14px; }
  .kv dt { color: var(--dim); }
  .kv dd { margin: 0; font-family: var(--mono); font-size: 13px; overflow-wrap: anywhere; }
  .big { font-size: 30px; font-weight: 650; font-family: var(--mono); line-height: 1.1; }
  .sub { color: var(--dim); font-size: 12.5px; }
  .meter { margin: 6px 0 10px; }
  .meter .lbl { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--dim); margin-bottom: 3px; }
  .meter .lbl b { color: var(--text); font-family: var(--mono); font-weight: 500; }
  .bar { height: 8px; background: var(--panel2); border-radius: 4px; overflow: hidden; }
  .bar > i { display: block; height: 100%; width: 0; background: var(--accent); border-radius: 4px; transition: width .4s; }
  .bar > i.warn { background: var(--warn); } .bar > i.bad { background: var(--bad); }
  .cores { display: grid; grid-template-columns: repeat(auto-fill, minmax(18px, 1fr)); gap: 3px; margin-top: 8px; }
  .core { height: 34px; background: var(--panel2); border-radius: 3px; position: relative; overflow: hidden; }
  .core > i { position: absolute; left: 0; right: 0; bottom: 0; background: var(--accent); transition: height .4s; }
  .gpu + .gpu { border-top: 1px solid var(--line); margin-top: 10px; padding-top: 10px; }
  .gpu .name { font-weight: 600; margin-bottom: 4px; }
  .stats { display: flex; gap: 18px; flex-wrap: wrap; margin: 4px 0 8px; }
  .stats div { font-family: var(--mono); font-size: 18px; }
  .stats small { display: block; font-family: system-ui, sans-serif; font-size: 11.5px; color: var(--dim); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; color: var(--dim); font-weight: 500; padding: 4px 6px; border-bottom: 1px solid var(--line); }
  td { padding: 5px 6px; border-bottom: 1px solid #222831; vertical-align: top; font-family: var(--mono); font-size: 12.5px; }
  td.n { text-align: right; white-space: nowrap; }
  .addr { display: block; }
  td.ip { word-break: break-all; }
  td.src { word-break: break-all; }
  td.time { white-space: nowrap; }
  .muted { color: var(--dim); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 10px; }
  .chip { background: var(--panel2); border: 1px solid var(--line); border-radius: 6px; padding: 3px 8px; font-size: 12.5px; }
  .chip b { color: var(--accent); font-weight: 600; margin-right: 6px; }
  .chan + .chan { border-top: 1px solid var(--line); margin-top: 12px; padding-top: 12px; }
  .chan-head { font-weight: 600; margin-bottom: 6px; }
  .chan-head span { color: var(--dim); font-weight: 400; font-family: var(--mono); margin-left: 8px; }
  .prog { height: 4px; background: var(--panel2); border-radius: 2px; margin-top: 4px; min-width: 120px; }
  .prog > i { display: block; height: 100%; background: var(--ok); border-radius: 2px; }
  .tag { display: inline-block; font-size: 11px; padding: 0 6px; border-radius: 4px; background: var(--panel2); color: var(--dim); margin-right: 4px; }
  .tag.on { color: var(--warn); }
  .empty { color: var(--dim); font-style: italic; padding: 6px 0; }
  form.amcp { display: flex; gap: 8px; }
  form.amcp input { flex: 1; min-width: 0; background: #0b0e12; color: var(--text); border: 1px solid var(--line);
                    border-radius: 6px; padding: 8px 10px; font: 14px var(--mono); }
  form.amcp input:focus { outline: none; border-color: var(--accent); }
  form.amcp button { background: #12304f; color: #bfe0ff; border: 1px solid #2a5a8a; border-radius: 6px;
                     padding: 0 18px; font-weight: 600; cursor: pointer; }
  form.amcp button:disabled { opacity: .5; cursor: wait; }
  #amcpOut { max-height: 260px; overflow: auto; margin: 10px 0 0; padding: 8px 10px; background: #0b0e12;
             border: 1px solid var(--line); border-radius: 6px; font: 12px/1.45 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  #amcpOut .cmd { color: var(--accent); } #amcpOut .ok { color: var(--ok); } #amcpOut .e { color: var(--bad); }
  #amcpOut .entry + .entry { border-top: 1px solid #222831; margin-top: 6px; padding-top: 6px; }
  .preview-box { aspect-ratio: 16 / 9; background: #000; border-radius: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center; color: var(--dim); }
  .preview-box iframe { width: 100%; height: 100%; border: 0; }
  #log { height: 420px; overflow: auto; margin: 0; padding: 8px 10px; background: #0b0e12; border: 1px solid var(--line);
         border-radius: 6px; font: 12px/1.45 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  #log .w { color: var(--warn); } #log .e { color: var(--bad); } #log .i { color: #c3cbd6; } #log .d { color: var(--dim); }
  label { cursor: pointer; user-select: none; color: var(--text); font-size: 13px; }
  select { background: var(--panel2); color: var(--text); border: 1px solid var(--line); border-radius: 5px; padding: 2px 6px; }
  .err { color: var(--bad); font-size: 12.5px; }
  @media (max-width: 480px) { main { grid-template-columns: 1fr; padding: 10px; } header { padding: 10px; } }
</style>
</head>
<body>
<header>
  <h1>CasparCG Monitor <span class="by">by sendust</span></h1>
  <span class="host" id="host">—</span>
  <div class="pills">
    <span class="pill" title="AMCP TCP connection"><span class="dot" id="amcpDot"></span><span id="amcpTxt">AMCP —</span></span>
    <span class="pill" id="clientsPill" title="AMCP clients"><span id="clientsTxt">Clients —</span></span>
    <span class="pill" title="OSC messages from CasparCG"><span class="dot" id="oscDot"></span><span id="oscTxt">OSC —</span></span>
    <span class="pill" title="casparcg-server process"><span class="dot" id="procDot"></span><span id="procTxt">Process —</span></span>
    <span class="pill" id="svcPill" title="systemd service"><span class="dot" id="svcDot"></span><span id="svcTxt">Service —</span></span>
  </div>
  <span class="spacer"></span>
  <span class="clock" id="clock"></span>
  <div class="actions">
    <button class="start" id="startBtn" hidden>Start service</button>
    <button class="stop" id="stopBtn" hidden>Stop service</button>
    <button class="kill" id="killBtn">Kill CasparCG</button>
  </div>
</header>

<main>
  <section>
    <h2>CPU</h2>
    <dl class="kv">
      <dt>Model</dt><dd id="cpuModel">—</dd>
      <dt>Architecture</dt><dd id="cpuArch">—</dd>
      <dt>Cores / Threads</dt><dd id="cpuCT">—</dd>
      <dt>Load avg</dt><dd id="cpuLoad">—</dd>
    </dl>
    <div class="meter"><div class="lbl"><span>Utilization</span><b id="cpuPct">—</b></div><div class="bar"><i id="cpuBar"></i></div></div>
    <div class="cores" id="cores"></div>
  </section>

  <section>
    <h2>Memory &amp; System</h2>
    <div class="meter"><div class="lbl"><span>RAM free <b id="ramFree">—</b> / total <b id="ramTotal">—</b></span><b id="ramPct">—</b></div><div class="bar"><i id="ramBar"></i></div></div>
    <div class="meter"><div class="lbl"><span>Swap used</span><b id="swapTxt">—</b></div><div class="bar"><i id="swapBar"></i></div></div>
    <dl class="kv">
      <dt>System uptime</dt><dd id="uptime">—</dd>
      <dt>Boot time</dt><dd id="boot">—</dd>
      <dt>Kernel</dt><dd id="kernel">—</dd>
    </dl>
  </section>

  <section>
    <h2>GPU</h2>
    <div id="gpus"><div class="empty">—</div></div>
  </section>

  <section>
    <h2>Network</h2>
    <table>
      <thead><tr><th>NIC</th><th>IP address</th><th class="n">Traffic</th></tr></thead>
      <tbody id="nets"></tbody>
    </table>
  </section>

  <section>
    <h2>CasparCG Process</h2>
    <div id="procBox"><div class="empty">—</div></div>
  </section>

  <section class="span2">
    <h2>Channels <span class="right sub" id="oscNote">via OSC</span></h2>
    <div id="channels"><div class="empty">—</div></div>
  </section>

  <section class="wide">
    <h2>AMCP Console <span class="right sub">Enter: send · ↑/↓: history</span></h2>
    <form class="amcp" id="amcpForm" autocomplete="off">
      <input type="text" id="amcpInput" placeholder="예: PLAY 1-1 nds LOOP" spellcheck="false">
      <button type="submit" id="amcpSend">Send</button>
    </form>
    <pre id="amcpOut" hidden></pre>
  </section>

  <section class="wide" id="previewSec">
    <h2>Preview <span class="right"><label><input type="checkbox" id="previewChk"> enable</label><span class="sub" id="previewSrc"></span></span></h2>
    <div class="preview-box" id="previewBox"><span>Preview disabled</span></div>
  </section>

  <section class="wide">
    <h2>CasparCG Log
      <span class="right">
        <span class="sub" id="logFile"></span>
        <select id="logLevel">
          <option value="all">all</option>
          <option value="warning">warning+</option>
          <option value="error">error only</option>
        </select>
        <label><input type="checkbox" id="logFollow" checked> follow</label>
      </span>
    </h2>
    <pre id="log"></pre>
  </section>
</main>

<script>
const $ = id => document.getElementById(id);
const store = {
  get(k, d) { try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
};
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c]));

function fmtBytes(b) {
  if (b == null) return '—';
  const u = ['B', 'KB', 'MB', 'GB', 'TB']; let i = 0;
  while (b >= 1024 && i < u.length - 1) { b /= 1024; i++; }
  return b.toFixed(i >= 3 ? 2 : (i ? 1 : 0)) + ' ' + u[i];
}
function fmtBps(b) {
  if (b == null) return '—';
  const u = ['bps', 'Kbps', 'Mbps', 'Gbps']; let i = 0;
  while (b >= 1000 && i < u.length - 1) { b /= 1000; i++; }
  return b.toFixed(i ? 2 : 0) + ' ' + u[i];
}
function fmtDur(s) {
  if (s == null) return '—';
  s = Math.floor(s);
  const d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60), sec = s % 60;
  const hms = [h, m, sec].map(v => String(v).padStart(2, '0')).join(':');
  return d ? `${d}d ${hms}` : hms;
}
function fmtTime(t) { return t ? new Date(t * 1000).toLocaleString('ko-KR', {hour12: false}) : '—'; }
function fmtClip(t) { const m = Math.floor(t / 60), s = t - m * 60; return `${m}:${s.toFixed(1).padStart(4, '0')}`; }
function setBar(el, pct, warn = 75, bad = 90) {
  pct = Math.max(0, Math.min(100, pct || 0));
  el.style.width = pct + '%';
  el.className = pct >= bad ? 'bad' : pct >= warn ? 'warn' : '';
}
function meter(label, pct, valueText) {
  const p = pct == null ? 0 : Math.max(0, Math.min(100, pct));
  const cls = p >= 90 ? 'bad' : p >= 75 ? 'warn' : '';
  return `<div class="meter"><div class="lbl"><span>${label}</span><b>${valueText ?? (pct == null ? 'N/A' : pct.toFixed(0) + ' %')}</b></div>
          <div class="bar"><i class="${cls}" style="width:${p}%"></i></div></div>`;
}
function dot(el, state) { el.className = 'dot' + (state ? ' ' + state : ''); }

// ------------------------------------------------------------------ status
let lastStatusOk = 0;
async function pollStatus() {
  try {
    const r = await fetch('/api/status', {cache: 'no-store'});
    const s = await r.json();
    lastStatusOk = Date.now();
    render(s);
  } catch (e) {
    dot($('amcpDot'), 'bad'); $('amcpTxt').textContent = 'monitor backend unreachable';
  }
}

function render(s) {
  $('host').textContent = s.hostname || '';

  // CPU
  const c = s.cpu;
  $('cpuModel').textContent = c.model;
  $('cpuArch').textContent = c.arch;
  $('cpuCT').textContent = `${c.cores} cores / ${c.threads} threads` + (c.sockets > 1 ? ` (${c.sockets} sockets)` : '');
  $('cpuLoad').textContent = c.load.map(v => v.toFixed(2)).join('  ');
  $('cpuPct').textContent = c.usage.toFixed(1) + ' %';
  setBar($('cpuBar'), c.usage);
  const cores = $('cores');
  if (cores.children.length !== c.per_core.length) {
    cores.innerHTML = c.per_core.map((_, i) => `<div class="core" title="cpu${i}"><i></i></div>`).join('');
  }
  c.per_core.forEach((v, i) => {
    const el = cores.children[i];
    el.firstChild.style.height = v + '%';
    el.firstChild.style.background = v >= 90 ? 'var(--bad)' : v >= 75 ? 'var(--warn)' : 'var(--accent)';
    el.title = `cpu${i}: ${v.toFixed(0)}%`;
  });

  // Memory & system
  const m = s.memory, usedPct = 100 * (1 - m.available / m.total);
  $('ramFree').textContent = fmtBytes(m.available);
  $('ramTotal').textContent = fmtBytes(m.total);
  $('ramPct').textContent = usedPct.toFixed(1) + ' % used';
  setBar($('ramBar'), usedPct);
  const swapUsed = m.swap_total - m.swap_free;
  $('swapTxt').textContent = m.swap_total ? `${fmtBytes(swapUsed)} / ${fmtBytes(m.swap_total)}` : 'none';
  setBar($('swapBar'), m.swap_total ? 100 * swapUsed / m.swap_total : 0, 30, 60);
  $('uptime').textContent = fmtDur(s.system.uptime);
  $('boot').textContent = fmtTime(s.system.boot);
  $('kernel').textContent = s.system.kernel;

  // GPU
  if (!s.gpus.length) {
    $('gpus').innerHTML = `<div class="empty">No GPU data</div>` + (s.gpu_error ? `<div class="err">${esc(s.gpu_error)}</div>` : '');
  } else {
    $('gpus').innerHTML = s.gpus.map(g => {
      const memPct = g.mem_total ? 100 * g.mem_used / g.mem_total : null;
      return `<div class="gpu">
        <div class="name">#${esc(g.index)} ${esc(g.name)}</div>
        <div class="stats">
          <div>${g.temp == null ? 'N/A' : g.temp.toFixed(0) + ' °C'}<small>Temperature</small></div>
          <div>${g.power == null ? 'N/A' : g.power.toFixed(1) + ' W'}<small>Power draw${g.power_limit ? ' / ' + g.power_limit.toFixed(0) + ' W' : ''}</small></div>
        </div>
        ${meter('GPU utilization', g.util)}
        ${meter('NVENC', g.enc)}
        ${meter('NVDEC', g.dec)}
        ${meter('VRAM', memPct, g.mem_total ? `${(g.mem_used / 1024).toFixed(2)} / ${(g.mem_total / 1024).toFixed(1)} GiB` : 'N/A')}
      </div>`;
    }).join('');
  }

  // Network
  $('nets').innerHTML = s.network.length ? s.network.map(n => `<tr>
      <td>${esc(n.name)}<div class="sub">${n.link_mbps ? n.link_mbps + ' Mb/s' : ''}</div></td>
      <td class="ip">${n.addrs.length ? n.addrs.map(a => `<span class="addr">${esc(a)}</span>`).join('') : '<span class="muted">—</span>'}</td>
      <td class="n"><span class="addr"><span class="muted">RX</span> ${fmtBps(n.rx_bps)}</span><span class="addr"><span class="muted">TX</span> ${fmtBps(n.tx_bps)}</span></td></tr>`).join('')
    : `<tr><td colspan="3" class="empty">No link-up interfaces</td></tr>`;

  // Process
  const p = s.process;
  dot($('procDot'), p ? 'ok' : 'bad');
  $('procTxt').textContent = p ? `Process up ${fmtDur(p.age)}` : 'Process not running';
  $('killBtn').disabled = !p || actionBusy;
  $('procBox').innerHTML = p ? `<dl class="kv">
      <dt>PID</dt><dd>${p.pid}</dd>
      <dt>Process age</dt><dd>${fmtDur(p.age)}</dd>
      <dt>Started</dt><dd>${fmtTime(p.started)}</dd>
      <dt>CPU</dt><dd>${p.cpu_pct == null ? '—' : p.cpu_pct.toFixed(1) + ' %'} <span class="muted">(incl. CEF, 100% = 1 thread)</span></dd>
      <dt>Memory (RSS)</dt><dd>${fmtBytes(p.rss)}</dd>
      <dt>Memory (PSS)</dt><dd>${fmtBytes(p.pss)} <span class="muted">server</span></dd>
      <dt>Total incl. CEF</dt><dd>${fmtBytes(p.total_pss)} <span class="muted">PSS, ${p.helpers} helper process(es)</span></dd>
      <dt>Threads</dt><dd>${p.threads ?? '—'}</dd>
      <dt>AMCP clients</dt><dd>${clientList(s.casparcg.amcp_clients)}</dd>
    </dl>` : `<div class="empty">casparcg-server is not running</div>`;

  // CasparCG link / OSC
  const k = s.casparcg;
  dot($('amcpDot'), k.amcp_connected ? 'ok' : 'bad');
  $('amcpTxt').textContent = k.amcp_connected
    ? `AMCP connected${k.version ? ' · ' + k.version : ''}`
    : `AMCP disconnected${k.amcp_since ? ' · ' + fmtDur(s.time - k.amcp_since) : ''}`;
  $('amcpTxt').parentElement.title = k.amcp_error || 'AMCP TCP connection';
  const clients = k.amcp_clients || [], others = clients.filter(c => !c.self).length;
  $('clientsTxt').textContent = `AMCP clients ${clients.length}` + (clients.length !== others ? ` (others ${others})` : '');
  $('clientsPill').title = clients.length
    ? clients.map(c => `${c.addr}:${c.port}${c.self ? '  (this monitor)' : ''}`).join('\n') : 'no AMCP clients';
  dot($('oscDot'), k.osc_live ? 'ok' : (k.osc_error ? 'bad' : 'warn'));
  $('oscTxt').textContent = k.osc_live ? 'OSC live' : (k.osc_error ? 'OSC error' : 'OSC idle');
  $('oscTxt').parentElement.title = k.osc_error || (k.osc_last ? 'last OSC ' + fmtTime(k.osc_last) : 'no OSC received yet');
  renderChannels(k);

  // systemd service
  svc = s.service;
  const installed = svc && svc.installed;
  $('svcPill').hidden = !installed;
  const running = installed && (svc.active === 'active' || svc.active === 'activating' || svc.active === 'reloading');
  $('startBtn').hidden = $('stopBtn').hidden = !installed;
  $('startBtn').disabled = actionBusy || running;
  $('stopBtn').disabled = actionBusy || !running;
  $('startBtn').title = running ? '서비스가 이미 실행 중입니다' : `systemctl start ${installed ? svc.name : ''}`;
  $('stopBtn').title = running ? `systemctl stop ${svc.name}` : '서비스가 실행 중이 아닙니다';
  if (installed) {
    const st = svc.active;
    dot($('svcDot'), st === 'active' ? 'ok' : st === 'failed' ? 'bad' : 'warn');
    $('svcTxt').textContent = `${svc.name}.service ${st}` + (svc.restarts ? ` · restarts ${svc.restarts}` : '');
    $('svcPill').title = `systemd: ${st}/${svc.sub}, ${svc.enabled}`;
  }

  // Preview source label
  const pv = s.preview;
  previewUrl = `${location.protocol}//${location.hostname}:${pv.webrtc_port}/${encodeURIComponent(pv.path)}/`;
  $('previewSrc').textContent = `mediamtx · ${pv.path}`;
  syncPreview();

  $('clock').textContent = fmtTime(s.time);
}

function clientList(clients) {
  if (!clients || !clients.length) return '<span class="muted">none</span>';
  return `${clients.length}` + clients.map(c =>
    `<span class="addr">${esc(c.addr)}:${c.port}${c.self ? ' <span class="muted">(this monitor)</span>' : ''}</span>`).join('');
}

function layerSource(fg) {
  const keys = ['file/name', 'file/path', 'url', 'template/path', 'path', 'name'];
  for (const key of keys) if (typeof fg[key] === 'string' && fg[key]) return fg[key];
  for (const [key, v] of Object.entries(fg)) if (key !== 'producer' && typeof v === 'string' && v) return v;
  return '';
}

function renderChannels(k) {
  if (!k.osc_live && !k.channels.length) {
    $('channels').innerHTML = `<div class="empty">${k.osc_error ? esc(k.osc_error) :
      (k.amcp_connected ? 'Waiting for OSC…' : 'Not connected to CasparCG')}</div>`;
    return;
  }
  $('channels').innerHTML = k.channels.map(ch => {
    const consumers = ch.consumers.length ? ch.consumers.map(c => {
      const d = c.details;
      const brief = [d.index != null ? '#' + d.index : '', d['video-mode'] || '', d.keyer ? 'key:' + d.keyer : '']
        .filter(Boolean).join(' · ');
      const tip = Object.entries(d).map(([a, b]) => `${a}: ${Array.isArray(b) ? b.join(', ') : b}`).join('\n');
      return `<span class="chip" title="${esc(tip)}"><b>${esc(c.type)}</b>${esc(brief || 'port ' + c.port)}</span>`;
    }).join('') : '<span class="muted">no consumers</span>';

    const layers = ch.layers.length ? `<table><thead><tr><th>Layer</th><th>Producer</th><th>Source</th><th>Time</th><th></th></tr></thead><tbody>` +
      ch.layers.map(L => {
        const fg = L.foreground, bg = L.background;
        const t = Array.isArray(fg['file/time']) ? fg['file/time'] : null;
        const timeCell = t && t[1] > 0
          ? `${fmtClip(t[0])} / ${fmtClip(t[1])}<div class="prog"><i style="width:${Math.min(100, 100 * t[0] / t[1])}%"></i></div>` : '';
        const tags = [fg.paused === true ? '<span class="tag on">paused</span>' : '',
                      fg.loop === true ? '<span class="tag">loop</span>' : ''].join('');
        const next = bg.producer && bg.producer !== 'empty'
          ? `<div class="sub">next: ${esc(bg.producer)} ${esc(layerSource(bg))}</div>` : '';
        return `<tr><td>${esc(L.layer)}</td><td>${esc(fg.producer || 'empty')}</td>
                <td class="src">${esc(layerSource(fg))}${next}</td><td class="time">${timeCell}</td><td>${tags}</td></tr>`;
      }).join('') + `</tbody></table>` : '<div class="empty">no active layers</div>';

    return `<div class="chan"><div class="chan-head">Channel ${esc(ch.channel)}<span>${esc(ch.format || '')}</span></div>
      <div class="sub">Consumers</div><div class="chips">${consumers}</div>
      <div class="sub">Layers</div>${layers}</div>`;
  }).join('');
}

// ------------------------------------------------------------------ AMCP console
const amcpHistory = store.get('amcpHistory', []);
let amcpPos = amcpHistory.length;
$('amcpForm').addEventListener('submit', async ev => {
  ev.preventDefault();
  const cmd = $('amcpInput').value.trim();
  if (!cmd) return;
  if (amcpHistory[amcpHistory.length - 1] !== cmd) amcpHistory.push(cmd);
  amcpHistory.splice(0, Math.max(0, amcpHistory.length - 50));
  store.set('amcpHistory', amcpHistory);
  amcpPos = amcpHistory.length;
  $('amcpSend').disabled = true;
  let res;
  try {
    const r = await fetch('/api/amcp', {method: 'POST', headers: {'Content-Type': 'application/json'},
                                        body: JSON.stringify({command: cmd})});
    res = await r.json();
  } catch (e) {
    res = {ok: false, response: 'request failed: ' + e};
  }
  $('amcpSend').disabled = false;
  $('amcpInput').value = '';
  const out = $('amcpOut');
  out.hidden = false;
  const time = new Date().toLocaleTimeString('ko-KR', {hour12: false});
  out.insertAdjacentHTML('afterbegin', `<div class="entry"><span class="muted">${time}</span> <span class="cmd">&gt; ${esc(cmd)}</span>\n<span class="${res.ok ? 'ok' : 'e'}">${esc(res.response)}</span></div>`);
  while (out.children.length > 30) out.lastElementChild.remove();
  $('amcpInput').focus();
});
$('amcpInput').addEventListener('keydown', ev => {
  if (ev.key !== 'ArrowUp' && ev.key !== 'ArrowDown') return;
  ev.preventDefault();
  amcpPos = Math.max(0, Math.min(amcpHistory.length, amcpPos + (ev.key === 'ArrowUp' ? -1 : 1)));
  $('amcpInput').value = amcpHistory[amcpPos] || '';
});

// ------------------------------------------------------------------ preview
let previewUrl = null, previewShown = null;
$('previewChk').checked = store.get('preview', false);
$('previewChk').addEventListener('change', () => { store.set('preview', $('previewChk').checked); syncPreview(); });
function syncPreview() {
  const want = $('previewChk').checked && previewUrl ? previewUrl : null;
  if (want === previewShown) return;
  previewShown = want;
  $('previewBox').innerHTML = want
    ? `<iframe src="${esc(want)}?controls=true&muted=true&autoplay=true&playsinline=true" allow="autoplay; fullscreen"></iframe>`
    : '<span>Preview disabled</span>';
}

// ------------------------------------------------------------------ log
let logKey = null, logLines = [];
$('logLevel').value = store.get('logLevel', 'all');
$('logLevel').addEventListener('change', () => { store.set('logLevel', $('logLevel').value); renderLog(); });
$('logFollow').addEventListener('change', () => { if ($('logFollow').checked) scrollLog(); });

function lineClass(l) {
  if (/\] \[(error|fatal)\]/.test(l)) return 'e';
  if (/\] \[warning\]/.test(l)) return 'w';
  if (/\] \[(debug|trace)\]/.test(l)) return 'd';
  return 'i';
}
function renderLog() {
  const lvl = $('logLevel').value;
  const keep = c => lvl === 'all' || (lvl === 'warning' ? c === 'w' || c === 'e' : c === 'e');
  $('log').innerHTML = logLines.map(l => [l, lineClass(l)]).filter(([, c]) => keep(c))
    .map(([l, c]) => `<span class="${c}">${esc(l)}</span>`).join('\n');
  scrollLog();
}
function scrollLog() { if ($('logFollow').checked) $('log').scrollTop = $('log').scrollHeight; }
async function pollLog() {
  try {
    const r = await fetch('/api/log' + (logKey ? '?key=' + encodeURIComponent(logKey) : ''), {cache: 'no-store'});
    const d = await r.json();
    if (d.unchanged) return;
    logKey = d.key;
    logLines = d.lines || [];
    $('logFile').textContent = d.file || 'no log file';
    renderLog();
  } catch (e) { /* backend down: status poll shows it */ }
}

// ------------------------------------------------------------------ kill / service control
let svc = null, actionBusy = false;
async function postAction(url, body, okText) {
  actionBusy = true;
  ['killBtn', 'stopBtn', 'startBtn'].forEach(id => $(id).disabled = true);
  try {
    const r = await fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify(Object.assign({confirm: true}, body))});
    const d = await r.json();
    alert((d.ok ? okText + ': ' : '실패: ') + d.message);
  } catch (e) {
    alert('요청 실패: ' + e);
  }
  actionBusy = false;
  pollStatus();
}
$('killBtn').addEventListener('click', () => {
  const autoRestart = svc && svc.installed && svc.active === 'active';
  const msg = '[1/2] CasparCG 서버 프로세스를 강제 종료합니다.\n송출이 중단됩니다.' +
    (autoRestart ? `\n\n${svc.name}.service가 실행 중이므로 약 3초 뒤 자동으로 다시 시작됩니다.\n완전히 멈추려면 "Stop service"를 사용하세요.` : '') +
    '\n\n계속할까요?';
  if (!confirm(msg)) return;
  if (!confirm('[2/2] 마지막 확인\n\n정말 CasparCG 프로세스를 강제 종료할까요? 송출이 즉시 중단됩니다.')) return;
  postAction('/api/kill', {}, '종료됨');
});
$('stopBtn').addEventListener('click', () => {
  if (!confirm(`[1/2] systemctl stop ${svc.name}\n\nCasparCG 서비스를 정지합니다.\n송출이 중단되고 자동 재시작되지 않습니다.\n계속할까요?`)) return;
  if (!confirm(`[2/2] 마지막 확인\n\n정말 ${svc.name} 서비스를 정지할까요? 송출이 즉시 중단됩니다.`)) return;
  postAction('/api/service', {action: 'stop'}, '정지됨');
});
$('startBtn').addEventListener('click', () => {
  if (!confirm(`[1/2] systemctl start ${svc.name}\n\nCasparCG 서비스를 시작합니다.\nDeckLink 출력이 다시 시작됩니다. 계속할까요?`)) return;
  if (!confirm(`[2/2] 마지막 확인\n\n정말 ${svc.name} 서비스를 시작할까요?`)) return;
  postAction('/api/service', {action: 'start'}, '시작됨');
});

pollStatus(); pollLog();
setInterval(pollStatus, 1000);
setInterval(pollLog, 2000);
</script>
</body>
